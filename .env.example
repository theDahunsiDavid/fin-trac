# FinTrac Environment Configuration

# Sync Functionality
# Master switch to enable/disable CouchDB sync (default: disabled)
# When disabled, the app runs fully offline/local using IndexedDB
VITE_SYNC_ENABLED=false

# Remote CouchDB URL for sync (server base URL — the database name is set separately)
VITE_COUCHDB_URL=http://localhost:5984
VITE_COUCHDB_DATABASE=fintrac

# CouchDB Authentication (optional — only needed if CouchDB requires auth)
# VITE_COUCHDB_USERNAME=admin
# VITE_COUCHDB_PASSWORD=password

# Sync Behavior (only used when VITE_SYNC_ENABLED=true)
VITE_SYNC_INTERVAL=30000        # Auto-sync interval in milliseconds (30 seconds)
VITE_SYNC_BATCH_SIZE=50         # Number of documents to sync in one batch
VITE_SYNC_AUTO_START=false      # Start auto-sync automatically on app load
VITE_SYNC_BIDIRECTIONAL=true    # Two-way sync (upload + download)
VITE_SYNC_DOWNLOAD_ONLY=false   # Only download changes from CouchDB
VITE_SYNC_UPLOAD_ONLY=false     # Only upload changes to CouchDB
VITE_SYNC_CONFLICT_RESOLUTION=remote-wins  # How to handle conflicts: remote-wins | local-wins | manual

# Application Configuration
# App name for database identification
VITE_APP_NAME=FinTrac

# Environment (development, staging, production)
VITE_APP_ENV=development